        {
          "type": "gameplay",
          "segment": "book",
          "blend": 2.0,
          "controls": false,
          "film": false,
          "hint_fa": "کتابش را باز کن.",
          "hint_en": "Open his book.",
          "hint_de": "Öffne sein Buch."
        },
        { "type": "camera", "mark": "Letter", "blend": 1.6 },
        { "type": "audio", "music": "music_setar_resolved", "fade": 5.0, "volume": 0.5 },
        { "type": "silence", "seconds": 2.2 },
        {
          "type": "letter",
          "lines": [
            { "fa": "اگه داری اینو می‌خونی، یعنی خونه‌ای. می‌دونستم مجبور می‌شن پست بدن.", "en": "If you're reading this, you're home. I knew they'd have to give you back.", "de": "Wenn du das hier liest, bist du zu Hause. Ich wusste, dass sie dich freilassen müssen." },
            { "fa": "ببخش که تا مترو باهات نیومدم. تا همیشه بابتش متأسف می‌مونم.", "en": "I'm sorry I didn't walk you to the metro. I'll be sorry about that forever.", "de": "Es tut mir leid, dass ich dich nicht zur Metro begleitet habe. Das werde ich mir nie verzeihen." },
            { "fa": "ازت ناراحت نیستم. هیچ‌وقت نبودم. حق داشتی روسری‌ت رو درست نکنی.", "en": "I'm not angry. I was never angry. You were right not to fix your scarf.", "de": "Ich bin dir nicht böse. Ich war es nie. Du hattest recht, dein Kopftuch nicht zu richten." },
            { "fa": "نذار دوباره کوچیکت کنن. نه به خاطر من، نه به خاطر مامان، نه به خاطر هیچ‌کس.", "en": "Don't let them make you small again. Not for me, not for Mom, not for anyone.", "de": "Lass nicht zu, dass sie dich wieder klein machen. Nicht für mich, nicht für Mama, für niemanden." },
            { "fa": "چایی رو تا داغه بخور. من هیچ‌وقت نخوردم.", "en": "Drink the tea while it's hot. I never did.", "de": "Trink den Tee, solange er heiß ist. Ich habe es nie getan." },
            { "fa": "— برادرت", "en": "— your brother", "de": "— dein Bruder" }
          ]
        },
        { "type": "silence", "seconds": 2.5 },
        { "type": "fade", "to": 1, "time": 3.5 },
        { "type": "silence", "seconds": 2.0 }
      ]
    },
