        { "type": "text", "who": "sister", "fa": "کجاست؟", "en": "Where is he?", "de": "Wo ist er?", "rate": 18 },
        { "type": "text", "who": "sister", "fa": "از دستم ناراحته که نذاشتم تا مترو باهام بیاد؟", "en": "Is he angry I didn't let him walk me?", "de": "Ist er böse auf mich, weil ich ihn nicht zur Metro habe mitkommen lassen?", "rate": 20 },
