        { "type": "camera", "mark": "CenterCam" },
        { "type": "fade", "to": 0, "time": 3.5, "color": "white", "wait": false },
        { "type": "caption", "fa": "خانه", "en": "HOME", "de": "ZU HAUSE" },
        { "type": "silence", "seconds": 4.0 },
        { "type": "text", "who": "mom", "fa": "درِ اتاقش رو از اون شب نبستیم. دست به هیچی نزدیم.", "en": "We haven't closed his door since that night. We didn't touch a thing.", "de": "Wir haben seine Tür seit jener Nacht nicht geschlossen. Wir haben nichts angerührt.", "rate": 15 },
        { "type": "text", "who": "sister", "fa": "چاییش… هنوز رو میزه؟", "en": "His tea… is it still on the desk?", "de": "Sein Tee… steht er noch auf dem Schreibtisch?", "rate": 14 },
        { "type": "text", "who": "mom", "fa": "برو تو اتاقش مادر. منتظر تو بود.", "en": "Go into his room, sweetheart. He was waiting for you.", "de": "Geh in sein Zimmer, mein Kind. Er hat auf dich gewartet.", "rate": 15 },
        { "type": "hide_text" },
        { "type": "silence", "seconds": 2.5 },
        { "type": "fade", "to": 1, "time": 2.5 },
        { "type": "silence", "seconds": 1.0 }
      ]
    },
    {
