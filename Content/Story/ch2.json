      "beats": [
        { "type": "place", "mark": "He", "hidden": true },
        { "type": "camera", "mark": "Desk" },
        { "type": "caption", "fa": "مهر ۱۴۰۱ · شب", "en": "MEHR 1401 · NIGHT · HIS ROOM" },
        { "type": "fade", "to": 0, "time": 2.5 },
        { "type": "phone", "action": "call", "fa": "کیان", "en": "Kian" },
        { "type": "silence", "seconds": 0.8 },
        { "type": "text", "who": "kian", "fa": "وقت سفارت نُه روز دیگه‌ست. هنوز می‌تونی بیای.", "en": "The appointment is in nine days. You can still come." },
        { "type": "text", "who": "kian", "fa": "از بیرون صدامون رو بلند می‌کنیم. وکیل. رسانه. همه‌چیز.", "en": "We'll be loud from outside. Lawyers. Media. Everything." },
        { "type": "text", "who": "he", "fa": "و کی می‌مونه؟", "en": "And who stays?" },
        { "type": "text", "who": "kian", "fa": "میلیون‌ها نفر. تو فقط یه نفری.", "en": "Millions of people. You're one guy." },
        { "type": "text", "who": "he", "fa": "این رو هر «یه نفری» می‌گه.", "en": "That's what every one guy says." },
        { "type": "hide_text" },
        { "type": "phone", "action": "freeze", "on": true },
        { "type": "silence", "seconds": 4.0 },
        { "type": "phone", "action": "freeze", "on": false },
        { "type": "text", "who": "kian", "fa": "فقط زنده برگرد.", "en": "Just come back alive.", "rate": 16 },
        {
          "type": "choice",
          "flag": "window_seat",
          "who": "he",
          "options": [
            { "value": "A", "fa": "یه صندلی کنار پنجره برام رزرو کن.", "en": "Book me a window seat." },
            { "value": "B", "fa": "(چیزی نمی‌گوید)", "en": "(Say nothing)", "silent": true }
          ]
        },
        { "type": "silence", "seconds": 1.5 },
        { "type": "phone", "action": "close" },
        { "type": "silence", "seconds": 1.5 },
        { "type": "fade", "to": 1, "time": 2.0 }
      ]
    },
